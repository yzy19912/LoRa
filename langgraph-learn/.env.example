# Copy to `.env` and fill in. Everything still runs without these —
# the graph degrades to mock content and skips tracing.

# --- Langfuse (observability). Required for example 04 / tracing. ---
# Create a project at https://cloud.langfuse.com (or self-host).
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Optional LLM backend -----------------------------------------------
# Leave unset to use the built-in mock researcher (no network needed).
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Set to 1 to route the planner/researcher nodes through the LLM.
USE_LLM=0